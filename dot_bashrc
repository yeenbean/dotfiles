# source secrets
if [ -f ~/.secrets ]; then
    source ~/.secrets
fi

# Added by cua-driver-rs installer — see https://github.com/trycua/cua
export PATH="/home/zima/.local/bin:$PATH"

# add homebrew to path
if [ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
elif [ -f "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv bash)"
fi

# set up editor
export EDITOR="zed --wait"
alias edit="$EDITOR"

# other aliases
alias ls="ls -Al"
alias la="ls -al"
alias chedit="chezmoi edit --apply"

# greetings

fgreeting=(
    ""
)

greeting=(
    ""
)

# render greeting
if command -v fastfetch &> /dev/null; then
    clear       # subjectively clear only if fastfetch is available
    fastfetch
fi

if [ $(cat /proc/uptime | awk '{print $1}' | cut -d. -f1) -lt 300 ]; then
    echo
    echo "${fgreeting[$((RANDOM % ${#fgreeting[@]}))]}"
    echo
    echo
else
    echo
    echo "${greeting[$((RANDOM % ${#greeting[@]}))]}"
    echo
    echo
fi
